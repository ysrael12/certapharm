CLUSTER=devnet
RPC_URL=https://devnet.helius-rpc.com/?api-key=XXXX
PUBLIC_BASE_URL=https://certapharm.vercel.app
PLATFORM_AUTHORITY=<base58 pubkey>
PLATFORM_SECRET=<base58 secret or JSON array>
SEALS_ENABLED=true
# Seal trees live in config/seal-trees.json. On a host with no writable disk, set SEAL_TREES to the same JSON, one line.
SEAL_TREES=
CUSTODY_INDEX_FALLBACK=false
LIBSQL_URL=file:./data/projections.db
LIBSQL_AUTH_TOKEN=
# Turns the /manager screens on. Without it they stay off. Writes sign with server-held keys: use a long random value.
MANAGER_TOKEN=<long random string>
